AI_CASE_LLM_MODE=mock
AI_CASE_LLM_MODEL=gpt-5.5
AI_CASE_LLM_BASE_URL=https://api.openai.com/v1
AI_CASE_LLM_WIRE_API=chat
# Seconds per HTTP attempt; transient transport failures retry at most once.
AI_CASE_SEARCH_TIMEOUT=90
AI_CASE_LLM_TIMEOUT=120
OPENAI_API_KEY=
AI_CASE_API_HOST=127.0.0.1
AI_CASE_API_PORT=8000
# AI_CASE_DATA_DIR defaults to project/data/runtime
AI_CASE_MCP_STATE_PATH=/tmp/ai-case-workbench-mcp-state.json
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Optional local speech recognition; download the model separately, then use its absolute directory.
DOUYIN_FASTER_WHISPER_MODEL=
# Alternative whisper.cpp setup also requires ffmpeg and ffprobe (or PyAV).
DOUYIN_WHISPER_CPP_BIN=
DOUYIN_WHISPER_CPP_MODEL=
TENCENT_DOCS_MCP_URL=https://docs.qq.com/openapi/mcp
TENCENT_DOCS_TOKEN=
TENCENT_DOCS_WRITE_TOOL=
TENCENT_DOCS_READ_TOOL=
TENCENT_DOCS_WRITE_ARGS_JSON=
TENCENT_DOCS_READ_ARGS_JSON=
# Daily WeCom digest. Credentials stay on the backend; never expose them to Vite.
AI_CASE_NOTIFICATIONS_ENABLED=false
AI_CASE_NOTIFICATION_PROVIDER=wecom_webhook
AI_CASE_WECOM_WEBHOOK_URL=
# For a personal API-mode smart bot, use provider=wecom_aibot.
AI_CASE_WECOM_BOT_ID=
AI_CASE_WECOM_BOT_SECRET=
# Bind the recipient with scripts/bind_wecom_aibot.py; avoid copying a guessed ID.
AI_CASE_WECOM_USER_ID=
# AI_CASE_WECOM_BINDING_FILE defaults to AI_CASE_DATA_DIR/wecom-aibot-binding.json.
